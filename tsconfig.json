{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "allowJs": true,           /* السطر ده هو اللي هيخلي الكود القديم يشتغل */
    "checkJs": false,          /* عشان ميزعقش في ملفات الـ JS القديمة */
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,            /* عشان تستفيد من قوة التايب سكريبت */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts", "**/*.js"], /* يشمل النوعين */
  "exclude": ["node_modules"]
}